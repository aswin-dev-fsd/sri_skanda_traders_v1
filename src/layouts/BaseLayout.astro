---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import BackToTop from '@/components/layout/BackToTop.astro';
import WhatsAppButton from '@/components/layout/WhatsAppButton.astro';
import Toast from '@/components/ui/Toast.astro';
import Lightbox from '@/components/ui/Lightbox.astro';
import ShowroomMode from '@/components/layout/ShowroomMode.astro';
import EnquiryDrawer from '@/components/drawers/EnquiryDrawer.astro';
import SelectionDrawer from '@/components/drawers/SelectionDrawer.astro';
import { business } from '@/config/site';

interface Props {
  /** Page title. The business name is appended. */
  title?: string;
  /** Meta description, unique per page. */
  description: string;
  /** Topic for the floating WhatsApp message. Defaults to the page title. */
  whatsappTopic?: string;
  /** Keep the page out of search engines (internal pages such as the styleguide). */
  noindex?: boolean;
}

const { title, description, whatsappTopic, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${business.name}` : `${business.name} | ${business.categories}`;
const topic = whatsappTopic ?? title ?? 'your tiles and bathware';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#123B32" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline>
      // JS flag, and showroom mode (?mode=showroom, remembered on the tablet; ?mode=off ends it).
      document.documentElement.classList.add('js');
      try {
        var mode = new URLSearchParams(location.search).get('mode');
        if (mode === 'showroom') localStorage.setItem('sst:mode', 'showroom');
        if (mode === 'off') localStorage.removeItem('sst:mode');
        if (localStorage.getItem('sst:mode') === 'showroom') document.documentElement.dataset.mode = 'showroom';
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <WhatsAppButton topic={topic} />
    <SelectionDrawer />
    <EnquiryDrawer />
    <Toast />
    <Lightbox />
    <ShowroomMode />
    <script>
      import '@/scripts/reveal';
      import '@/scripts/drawer';
      import '@/scripts/shortlist';
      import '@/scripts/search';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: var(--space-1);
    left: var(--space-1);
    z-index: 100;
    padding: 12px var(--space-2);
    border-radius: var(--radius-button);
    background: var(--gold);
    color: var(--green);
    font-weight: 600;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
