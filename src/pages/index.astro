---
// Home (brief Prompt 01): exactly 9 sections, then the shared footer.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import ShopByCategory from '@/components/home/ShopByCategory.astro';
import ShopBySpace from '@/components/home/ShopBySpace.astro';
import VisualizerBand from '@/components/home/VisualizerBand.astro';
import Trending from '@/components/home/Trending.astro';
import WhySriSkanda from '@/components/home/WhySriSkanda.astro';
import Brands from '@/components/home/Brands.astro';
import RealHomes from '@/components/home/RealHomes.astro';
import VisitShowroom from '@/components/home/VisitShowroom.astro';
import { features } from '@/config/site';
---

<BaseLayout
  description="Floor and wall tiles, granite and bathware from brands you trust, with honest advice at our showroom in Sulur, Coimbatore."
  whatsappTopic="your tiles and bathware"
>
  <Hero />
  <ShopByCategory />
  <ShopBySpace />
  {features.visualizer && <VisualizerBand />}
  <Trending />
  <WhySriSkanda />
  <Brands />
  <RealHomes />
  <VisitShowroom />
</BaseLayout>
