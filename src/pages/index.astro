---
// Temporary setup page: shows the design tokens so task 1 can be reviewed.
// Replaced by the real Home page in task 6.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { business } from '@/config/site';

const colours = [
  { name: 'Royal Forest Green', token: '--green', hex: '#123B32', ink: 'light' },
  { name: 'Warm Ivory', token: '--ivory', hex: '#F8F6EF', ink: 'dark' },
  { name: 'Champagne Gold', token: '--gold', hex: '#D4AF37', ink: 'dark' },
  { name: 'Deep Charcoal Green', token: '--charcoal', hex: '#2E3A35', ink: 'light' },
  { name: 'Stone Beige', token: '--beige', hex: '#E7E2D6', ink: 'dark' },
];
const tints = [
  { name: 'Card surface', token: '--surface', hex: '#FFFDF8', ink: 'dark' },
  { name: 'Muted on ivory', token: '--muted', hex: '#5B655F', ink: 'light' },
  { name: 'Muted on green', token: '--muted-on-green', hex: '#C9D3CC', ink: 'dark' },
  { name: 'Green hover', token: '--green-hover', hex: '#0E2F28', ink: 'light' },
  { name: 'Gold hover', token: '--gold-hover', hex: '#C29E2C', ink: 'dark' },
];
const radii = [
  { name: 'Card', token: '--radius-card', value: '20px' },
  { name: 'Image', token: '--radius-image', value: '16px' },
  { name: 'Button', token: '--radius-button', value: '12px' },
  { name: 'Chip', token: '--radius-chip', value: '999px' },
];
---

<BaseLayout title="Design tokens" description="Setup preview of the Sri Skanda Traders design tokens.">
  <Fragment>
    <section class="section">
      <div class="container stack">
        <p class="eyebrow rise">Task 1 · Project setup</p>
        <h1 class="rise" style="--i: 1">Tiles you'll love living with.</h1>
        <p class="body-lg muted rise" style="--i: 2">
          A preview of the {business.name} design tokens: colours, type, spacing and shape. This page is replaced
          by the Home page in task 6.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="colour-title">
      <div class="container stack">
        <p class="eyebrow">01 — Colour</p>
        <h2 id="colour-title">Palette and allowed tints</h2>
        <ul class="swatches">
          {
            [...colours, ...tints].map((c) => (
              <li class="swatch" data-ink={c.ink} style={`background: var(${c.token})`}>
                <span class="swatch-name">{c.name}</span>
                <span class="small tabular">
                  {c.hex} · <code>{c.token}</code>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="type-title">
      <div class="container stack">
        <p class="eyebrow">02 — Type</p>
        <h2 id="type-title">Poppins, four weights</h2>
        <div class="type-scale">
          <p class="display">Display H1 · 700</p>
          <h2>Heading H2 · 700</h2>
          <h3>Heading H3 · 600</h3>
          <p class="body-lg">
            Body large · 400. Floor and wall tiles, granite and bathware from brands you trust, chosen with honest
            advice at our showroom in Sulur, Coimbatore.
          </p>
          <p>Body · 400. Paragraphs stay between 60 and 68 characters wide so they are easy to read.</p>
          <p class="small muted">Small / meta · 400 · <span class="tabular">600 × 1200 mm</span></p>
        </div>
      </div>
    </section>

    <section class="section on-green" aria-labelledby="green-title">
      <div class="container stack">
        <p class="eyebrow">03 — On green</p>
        <h2 id="green-title">See it in your home before you buy.</h2>
        <p class="body-lg muted">
          Ivory headings, muted body text and gold eyebrows on Royal Forest Green.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="shape-title">
      <div class="container stack">
        <p class="eyebrow">04 — Shape</p>
        <h2 id="shape-title">Radii and the soft lift shadow</h2>
        <ul class="radii">
          {
            radii.map((r) => (
              <li class="radius" style={`border-radius: var(${r.token})`}>
                <span class="small">
                  {r.name} · <span class="tabular">{r.value}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </Fragment>
</BaseLayout>

<style>
  .stack {
    display: grid;
    gap: var(--space-3);
  }

  .swatches {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-2);
  }

  .swatch {
    display: grid;
    align-content: end;
    gap: 4px;
    min-height: 140px;
    padding: var(--space-2);
    border: var(--border);
    border-radius: var(--radius-card);
  }

  .swatch[data-ink='light'] {
    color: var(--on-green);
  }

  .swatch[data-ink='dark'] {
    color: var(--green);
  }

  .swatch-name {
    font-weight: 600;
  }

  .type-scale {
    display: grid;
    gap: var(--space-3);
  }

  .radii {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .radius {
    display: grid;
    place-items: center;
    width: 180px;
    height: 120px;
    background: var(--surface);
    border: var(--border);
    transition:
      transform var(--dur-ui-slow) var(--ease),
      box-shadow var(--dur-ui-slow) var(--ease);
  }

  .radius:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }
</style>
