---
// Temporary Home: replaced by the real Home page in task 6.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
---

<BaseLayout description="Tiles, granite and bathware showroom in Sulur, Coimbatore." noindex>
  <section class="section">
    <div class="container" style="display: grid; gap: var(--space-3)">
      <p class="eyebrow">Tiles · Granite · Bathware</p>
      <h1>Tiles you'll love living with.</h1>
      <p class="body-lg muted">The Home page is built in task 6. Until then, the styleguide shows the shared parts.</p>
      <div><Button href="/styleguide" arrow>Open the styleguide</Button></div>
    </div>
  </section>
</BaseLayout>
