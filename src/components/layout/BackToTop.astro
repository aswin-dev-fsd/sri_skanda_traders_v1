---
// Back-to-top button, stacked above the floating WhatsApp button. Appears after 1.5 screens of
// scroll, so short pages never show it. Follows the WhatsApp button's hide rules (drawer/menu open,
// showroom mode) and its raised position over a docked bottom bar.
import Icon from '@/components/ui/Icon.astro';
---

<button type="button" class="to-top" aria-label="Back to top" data-to-top>
  <Icon name="arrow-up" size={22} />
</button>

<style>
  .to-top {
    position: fixed;
    right: calc(var(--space-3) + 6px); /* centred over the 56px WhatsApp button */
    bottom: calc(var(--space-3) + 56px + 12px);
    z-index: 40;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1.5px solid var(--green);
    border-radius: 50%;
    background: var(--surface);
    color: var(--green);
    box-shadow: 0 6px 18px rgba(14, 47, 40, 0.18);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition:
      opacity var(--dur-ui) var(--ease),
      transform var(--dur-ui-slow) var(--ease);
  }

  .to-top.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .to-top.is-visible:hover {
    transform: translateY(-2px);
  }

  :global(:root[data-overlay]) .to-top.is-visible {
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
  }

  @media (max-width: 1023px) {
    :global(:root[data-bar-visible]) .to-top {
      bottom: calc(92px + 56px + 12px);
    }
  }

  :global(:root[data-mode='showroom']) .to-top {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .to-top,
    .to-top.is-visible:hover {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-to-top]');
  if (btn) {
    let ticking = false;
    const update = () => {
      btn.classList.toggle('is-visible', window.scrollY > window.innerHeight * 1.5);
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();

    btn.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      // Send keyboard focus to the top so the next Tab starts from the header.
      const main = document.getElementById('main');
      if (main) {
        main.setAttribute('tabindex', '-1');
        main.focus({ preventScroll: true });
        main.addEventListener('blur', () => main.removeAttribute('tabindex'), { once: true });
      }
    });
  }
</script>
