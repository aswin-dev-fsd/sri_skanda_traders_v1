---
// Product card for bathware, granite and adhesives (brief Prompt 00-H): square image on the card
// surface with the product centred, brand, name, code and one key spec; star and Enquire.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Button from '@/components/ui/Button.astro';
import PhotoPlaceholder from '@/components/ui/PhotoPlaceholder.astro';
import SaveStar from '@/components/ui/SaveStar.astro';
import type { SelectionItem } from '@/lib/types';
import { routes } from '@/config/site';

interface Props {
  id: string;
  href: string;
  brand: string;
  name: string;
  code: string;
  /** One key spec, e.g. "Wall-hung · 520 × 360 mm". */
  spec: string;
  image?: ImageMetadata;
  /** Shows the "Authorised Dealer" tag (Johnson, JSW). */
  authorised?: boolean;
  /** Stand-in thumbnail colour for My Selection until photos arrive. */
  swatch?: string;
}

const { id, href, brand, name, code, spec, image: imageProp, authorised = false, swatch } = Astro.props;
// Callers pass only text; the photo comes from the product's own entry when it has one.
const image = imageProp ?? (await getEntry('products', id))?.data.images[0];
const item: SelectionItem = { id, kind: 'product', name, brand, code, href, swatch };
---

<article class="product-card">
  <div class="media">
    {
      image ? (
        <Image src={image} alt={name} widths={[280, 420, 560]} sizes="(min-width: 1200px) 300px, (min-width: 768px) 30vw, 45vw" />
      ) : (
        <PhotoPlaceholder label={`${name}, product shot`} face="var(--surface)" />
      )
    }
    {authorised && <span class="tag">Authorised Dealer</span>}
    <SaveStar item={item} class="card-star" />
  </div>

  <div class="body">
    <p class="brand">{brand}</p>
    <h3 class="name"><a href={href} class="card-link">{name}</a></h3>
    <p class="small muted tabular">{code}</p>
    <p class="small spec tabular">{spec}</p>
    <div class="actions">
      <Button variant="primary" size="sm" href={routes.contact} class="raise" data-enquire data-item={JSON.stringify(item)}>
        Enquire
      </Button>
    </div>
  </div>
</article>

<style>
  /* One object, matching the collection card: ivory panel, beige border, image flush at the top
     (a beige rule under it), text padded inside. Hover lifts the card and fades in a shadow. */
  .product-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    transition: transform var(--dur-ui-slow) var(--ease);
  }

  .product-card::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    box-shadow: var(--shadow-lift);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-ui-slow) var(--ease);
  }

  @media (hover: hover) {
    .product-card:hover {
      transform: translateY(-4px);
    }

    .product-card:hover::before {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card:hover {
      transform: none;
      transition: none;
    }
  }

  .media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-bottom: var(--border);
    border-radius: calc(var(--radius-card) - 1px) calc(var(--radius-card) - 1px) 0 0;
    background: var(--surface);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8%;
    transition: transform var(--dur-reveal) var(--ease);
  }

  .product-card:hover .media :global(img) {
    transform: scale(1.04);
  }

  .tag {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    padding: 5px 10px;
    border: 1px solid var(--gold);
    border-radius: var(--radius-chip);
    background: var(--surface);
    color: var(--green);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .media :global(.card-star) {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 3;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-3);
  }

  @media (max-width: 599px) {
    .body {
      padding: 14px 12px;
    }
  }

  .brand {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .name {
    font-size: 18px;
  }

  .card-link {
    color: var(--green);
    text-decoration: none;
  }

  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card-link:focus-visible {
    outline: none;
  }

  .product-card:has(.card-link:focus-visible) {
    outline: 2px solid var(--green);
    outline-offset: 4px;
  }

  .spec {
    color: var(--charcoal);
  }

  /* Enquire is the only button, so it is filled and spans the card's width, like the two halves
     on collection cards. */
  .actions {
    display: grid;
    margin-top: auto;
    padding-top: 12px;
  }

  .actions :global(.raise) {
    position: relative;
    z-index: 2;
  }
</style>
