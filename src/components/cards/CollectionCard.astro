---
// Collection card for tiles (brief Prompt 00-G). 4:5 room photo with the FLIP CARD behaviour:
// on hover (mouse) it cross-fades to the flat tile face; on touch screens a "Room | Tile" toggle
// sits on the image corner instead. The whole card links to the Collection page.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import PhotoPlaceholder from '@/components/ui/PhotoPlaceholder.astro';
import SaveStar from '@/components/ui/SaveStar.astro';
import type { SelectionItem } from '@/lib/types';
import { routes } from '@/config/site';

interface Props {
  id: string;
  href: string;
  brand: string;
  name: string;
  colours: number;
  finishes: number;
  sizes: number;
  /** Up to 5 colour dots (CSS colours). */
  dots?: string[];
  room?: ImageMetadata;
  tile?: ImageMetadata;
  /** Used for the placeholder and as alt text while photos are missing. */
  roomLabel?: string;
  /** CSS background for the tile-face placeholder. */
  tileFace?: string;
  /** Small tag on the image, e.g. "New". */
  badge?: string;
  /** Load the image eagerly (first row of a page). */
  eager?: boolean;
}

const {
  id,
  href,
  brand,
  name,
  colours,
  finishes,
  sizes,
  dots = [],
  room,
  tile,
  roomLabel = `room with ${name} tiles`,
  tileFace,
  badge,
  eager = false,
} = Astro.props;

const count = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const meta = [count(colours, 'colour', 'colours'), count(finishes, 'finish', 'finishes'), count(sizes, 'size', 'sizes')].join(
  ' · ',
);
const item: SelectionItem = { id, kind: 'collection', name, brand, href, swatch: dots[0] };
const loading = eager ? 'eager' : 'lazy';
---

<article class="collection-card" data-flip-card data-face="room">
  <div class="media">
    <div class="layer room">
      {room ? <Image src={room} alt={roomLabel} widths={[320, 480, 640]} sizes="(min-width: 1200px) 400px, (min-width: 768px) 45vw, 90vw" loading={loading} /> : <PhotoPlaceholder label={roomLabel} />}
    </div>
    <div class="layer tile" aria-hidden="true">
      {tile ? <Image src={tile} alt="" widths={[320, 480, 640]} sizes="(min-width: 1200px) 400px, (min-width: 768px) 45vw, 90vw" loading="lazy" /> : <PhotoPlaceholder label={`${name} tile face`} face={tileFace} />}
    </div>

    {badge && <span class="badge">{badge}</span>}
    <SaveStar item={item} class="card-star" />

    <div class="face-toggle" role="group" aria-label="Show room or tile">
      <button type="button" aria-pressed="true" data-face-btn="room">Room</button>
      <button type="button" aria-pressed="false" data-face-btn="tile">Tile</button>
    </div>
  </div>

  <div class="body">
    <p class="brand">{brand}</p>
    <h3 class="name"><a href={href} class="card-link">{name}</a></h3>
    <p class="meta small">{meta}</p>
    {
      dots.length > 0 && (
        <ul class="dots" aria-label={`${colours} colours`}>
          {dots.slice(0, 5).map((d) => (
            <li style={`background: ${d}`} />
          ))}
        </ul>
      )
    }
    <div class="actions">
      <Button variant="text" href={href} arrow class="raise" tabindex="-1" aria-hidden="true">View</Button>
      <Button variant="secondary" size="sm" href={routes.contact} class="raise" data-enquire data-item={JSON.stringify(item)}>
        Enquire
      </Button>
    </div>
  </div>
</article>

<style>
  .collection-card {
    position: relative;
    display: grid;
    gap: var(--space-2);
  }

  .media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-image);
    background: var(--beige);
  }

  .layer {
    position: absolute;
    inset: 0;
    transition:
      opacity var(--dur-reveal) var(--ease),
      transform var(--dur-reveal) var(--ease);
  }

  .layer :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile {
    opacity: 0;
  }

  [data-face='tile'] .tile {
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .collection-card:hover .tile {
      opacity: 1;
    }

    .collection-card:hover .layer {
      transform: scale(1.04);
    }

    .face-toggle {
      display: none !important;
    }
  }

  .badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    padding: 6px 10px;
    border-radius: var(--radius-chip);
    background: var(--green);
    color: var(--on-green);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .media :global(.card-star) {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 3;
  }

  .face-toggle {
    position: absolute;
    left: 10px;
    bottom: 10px;
    z-index: 3;
    display: flex;
    padding: 3px;
    border-radius: var(--radius-chip);
    background: rgba(255, 253, 248, 0.92);
  }

  .face-toggle button {
    min-width: 52px;
    height: 36px;
    padding: 0 12px;
    border: 0;
    border-radius: var(--radius-chip);
    background: transparent;
    color: var(--green);
    font-size: 13px;
    font-weight: 600;
  }

  .face-toggle button[aria-pressed='true'] {
    background: var(--green);
    color: var(--on-green);
  }

  .body {
    display: grid;
    gap: 6px;
  }

  .brand {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .card-link {
    color: var(--green);
    text-decoration: none;
  }

  /* Stretched link: the whole card opens the Collection page. */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card-link:focus-visible {
    outline: none;
  }

  .collection-card:has(.card-link:focus-visible) {
    outline: 2px solid var(--green);
    outline-offset: 6px;
    border-radius: var(--radius-image);
  }

  .meta {
    color: var(--muted);
  }

  .dots {
    display: flex;
    gap: 6px;
    padding: 2px 0 0;
    list-style: none;
  }

  .dots li {
    width: 14px;
    height: 14px;
    border: 1px solid rgba(46, 58, 53, 0.15);
    border-radius: 50%;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: 4px;
  }

  .actions :global(.raise) {
    position: relative;
    z-index: 2;
  }
</style>

<script>
  // Touch toggle between the room photo and the flat tile face.
  document.querySelectorAll<HTMLElement>('[data-flip-card]').forEach((card) => {
    card.querySelectorAll<HTMLButtonElement>('[data-face-btn]').forEach((button) => {
      button.addEventListener('click', () => {
        const face = button.dataset.faceBtn ?? 'room';
        card.dataset.face = face;
        card.querySelectorAll<HTMLButtonElement>('[data-face-btn]').forEach((b) => {
          b.setAttribute('aria-pressed', String(b === button));
        });
      });
    });
  });
</script>
