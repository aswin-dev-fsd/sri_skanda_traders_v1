---
// Visualizer 02 — How it works: five numbered steps, horizontal on desktop and vertical on phones,
// joined by a thin gold line that draws as you scroll.
// DRAFT: the step wording will be matched to the visualizer's real controls before launch.
const steps = [
  { title: 'Choose an angle', body: 'Pick the view of the room you want to see.' },
  { title: 'Tap the floor or a wall', body: 'Select the surface you want to change.' },
  { title: 'Pick a tile', body: 'Browse the list and tap a tile to apply it.' },
  { title: 'Look around', body: 'Move around the room to see it from every side.' },
  { title: 'Save or enquire', body: 'Keep it in My Selection or ask us about it.' },
];
---

<section class="section divided how" id="how-it-works" aria-labelledby="how-title">
  <div class="container">
    <div class="head" data-reveal>
      <p class="eyebrow">How it works</p>
      <h2 id="how-title">Five steps to see your tile in place.</h2>
    </div>

    <div class="stepper" data-stepper>
      <span class="track" aria-hidden="true"><span class="fill" data-stepper-fill></span></span>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step" data-reveal style={`--i: ${i}`}>
              <span class="num tabular" aria-hidden="true">{i + 1}</span>
              <div class="text">
                <h3>{s.title}</h3>
                <p class="muted small">{s.body}</p>
                <span class="shot small">[SCREENSHOT: step {i + 1}]</span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* Matches the embed area's 96px bottom, so the divider line between them sits evenly. */
  .how {
    padding-top: var(--space-12);
  }

  .head {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .stepper {
    position: relative;
  }

  .steps {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: var(--space-2);
  }

  .num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1.5px solid var(--green);
    border-radius: 50%;
    background: var(--ivory);
    color: var(--green);
    font-size: 18px;
    font-weight: 600;
    transition: color var(--dur-ui) var(--ease);
  }

  .step:hover .num {
    color: var(--gold);
  }

  .text {
    display: grid;
    gap: 6px;
    padding-top: 10px;
  }

  .text h3 {
    font-size: 18px;
  }

  .shot {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    max-width: 280px;
    margin-top: 6px;
    border: 1px dashed var(--beige);
    border-radius: var(--radius-image);
    background: var(--surface);
    color: var(--muted);
    font-size: 12px;
  }

  /* The gold line: vertical on phones, horizontal from tablet up. Drawn by scaling (transform only). */
  .track {
    position: absolute;
    top: 26px;
    bottom: 26px;
    left: 25px;
    width: 1.5px;
    background: var(--beige);
  }

  .fill {
    position: absolute;
    inset: 0;
    background: var(--gold);
    transform: scaleY(var(--progress, 0));
    transform-origin: top;
  }

  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--space-3);
    }

    .step {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .text {
      padding-top: 0;
    }

    .track {
      top: 25px;
      bottom: auto;
      left: 26px;
      right: calc((100% - 4 * var(--space-3)) / 5 - 26px);
      width: auto;
      height: 1.5px;
    }

    .fill {
      transform: scaleX(var(--progress, 0));
      transform-origin: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fill {
      transform: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-stepper]').forEach((stepper) => {
    const fill = stepper.querySelector<HTMLElement>('[data-stepper-fill]');
    const track = fill?.parentElement ?? stepper;
    let ticking = false;
    const update = () => {
      ticking = false;
      // Measure the line itself, not the whole stepper: on desktop the line only runs along the
      // circles, so the tall screenshot cards below must not hold it back.
      const box = track.getBoundingClientRect();
      const vh = window.innerHeight;
      // 0 when the line's top reaches 85% down the screen, 1 when its bottom passes 35%.
      const progress = (vh * 0.85 - box.top) / (box.height + vh * 0.5);
      fill?.style.setProperty('--progress', String(Math.min(1, Math.max(0, progress))));
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  });
</script>
