---
// Home 08 — Real homes: one large project photo with "Shop this look", and a stack of review
// cards with arrows. Only real reviews: placeholders stay until the client supplies them.
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import PhotoPlaceholder from '@/components/ui/PhotoPlaceholder.astro';
import { featuredProject, reviews } from '@/config/home';
import { routes } from '@/config/site';
import { collectionHref } from '@/lib/catalogue';

const shopHref = featuredProject.collectionId ? collectionHref(featuredProject.collectionId) : routes.tiles;
const pageSize = 2;
---

<section class="section divided homes" aria-labelledby="homes-title">
  <div class="container">
    <div class="head" data-reveal>
      <p class="eyebrow">Real homes</p>
      <h2 id="homes-title">Homes we're proud to be part of.</h2>
    </div>

    <div class="inner">
      <figure class="project" data-reveal>
        <div class="photo"><PhotoPlaceholder label="finished living room in a customer's home" /></div>
        <figcaption class="caption">
          <span class="muted">{featuredProject.title}, {featuredProject.area} · Tiles: {featuredProject.collection}</span>
          <Button variant="text" href={shopHref} arrow>Shop this look</Button>
        </figcaption>
      </figure>

      <div class="reviews" data-reviews data-page="0" data-reveal style="--i: 1">
        <ul class="review-list">
          {
            reviews.map((r, i) => (
              <li class="review" data-review-page={Math.floor(i / pageSize)} hidden={i >= pageSize}>
                <blockquote>
                  <p class="body-lg">{r.text}</p>
                </blockquote>
                <p class="who small">
                  <span>
                    <strong>{r.name}</strong> · {r.area}
                  </span>
                  {r.source === 'google' && <span class="source muted">Google review</span>}
                </p>
              </li>
            ))
          }
        </ul>
        <div class="review-nav">
          <button type="button" class="nav-btn" aria-label="Previous reviews" data-review-prev>
            <Icon name="arrow-right" size={20} class="flip" />
          </button>
          <button type="button" class="nav-btn" aria-label="More reviews" data-review-next>
            <Icon name="arrow-right" size={20} />
          </button>
        </div>
      </div>
    </div>

    <div class="more">
      <Button variant="text" href={routes.gallery} arrow>See all projects and reviews</Button>
    </div>
  </div>
</section>

<style>
  /* Matches the compact Brands section above (96px), so the divider line between them sits
     evenly at every screen size. */
  .homes {
    padding-top: var(--space-12);
  }

  .head {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .inner {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 1200px) {
    .inner {
      grid-template-columns: 7fr 5fr;
      gap: var(--space-8);
      align-items: start;
    }
  }

  .project {
    margin: 0;
  }

  .photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-image);
  }

  .caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px var(--space-2);
    margin-top: var(--space-2);
  }

  .reviews {
    display: grid;
    gap: var(--space-3);
  }

  .review-list {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .review {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    animation: panel-in 250ms var(--ease);
  }

  .review[hidden] {
    display: none;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
    }
  }

  blockquote {
    margin: 0;
  }

  .who {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    color: var(--green);
  }

  .review-nav {
    display: flex;
    gap: 12px;
  }

  .nav-btn {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1.5px solid var(--green);
    border-radius: 50%;
    background: transparent;
    color: var(--green);
  }

  .nav-btn:hover {
    background: rgba(18, 59, 50, 0.06);
  }

  .nav-btn[disabled] {
    opacity: 0.35;
    pointer-events: none;
  }

  .nav-btn :global(.flip) {
    transform: rotate(180deg);
  }

  .more {
    margin-top: var(--space-4);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach((box) => {
    const cards = [...box.querySelectorAll<HTMLElement>('[data-review-page]')];
    const pages = Math.max(...cards.map((c) => Number(c.dataset.reviewPage))) + 1;
    const prev = box.querySelector<HTMLButtonElement>('[data-review-prev]');
    const next = box.querySelector<HTMLButtonElement>('[data-review-next]');
    let page = 0;
    const show = () => {
      cards.forEach((c) => (c.hidden = Number(c.dataset.reviewPage) !== page));
      if (prev) prev.disabled = page === 0;
      if (next) next.disabled = page === pages - 1;
    };
    prev?.addEventListener('click', () => {
      page = Math.max(0, page - 1);
      show();
    });
    next?.addEventListener('click', () => {
      page = Math.min(pages - 1, page + 1);
      show();
    });
    show();
  });
</script>
