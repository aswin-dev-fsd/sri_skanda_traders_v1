---
// The one listing template (brief Prompt 02): all tiles, floor/wall/vitrified, each space, and
// bathware/granite/adhesives with product cards. Filtering runs in the browser on build-time
// cards; selections are written to the URL so a filtered view can be shared.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Drawer from '@/components/drawers/Drawer.astro';
import FilterGroups from '@/components/listing/FilterGroups.astro';
import CollectionCard from '@/components/cards/CollectionCard.astro';
import ProductCard from '@/components/cards/ProductCard.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { categoryTabs, tileTabs, type Listing } from '@/config/listings';
import { features, routes } from '@/config/site';
import { getProducts, getTiles } from '@/lib/catalogue';
import { SORTS } from '@/lib/filters';
import { buildListing } from '@/lib/listing-data';
import { whatsappUrl } from '@/lib/links';

interface Props {
  listing: Listing;
}

const { listing } = Astro.props;
const { items, groups } = await buildListing(listing);
const isTiles = listing.kind === 'tiles';
const noun = isTiles ? ['collection', 'collections'] : ['product', 'products'];
const PAGE_SIZE = 12;

// For the client: group keys, allowed values and labels.
const groupData = groups.map((g) => ({ key: g.key, label: g.label, options: g.options.map((o) => ({ value: o.value, label: o.label })) }));

// /products?brand=johnson: send brands with no tiles to the listing where they have products.
let brandRoutes: Record<string, string> = {};
if (listing.path === routes.products) {
  const tileBrands = new Set((await getTiles()).map((t) => t.entry.data.brand.id));
  for (const kind of ['bathware', 'granite', 'adhesives'] as const) {
    for (const p of await getProducts(kind)) {
      const id = p.entry.data.brand.id;
      if (!tileBrands.has(id) && !brandRoutes[id]) brandRoutes[id] = routes[kind];
    }
  }
}

const showVitrifiedStrip = isTiles && (listing.tileTab === 'all' || listing.tileTab === 'vitrified') && !listing.fixed.space;
const roomName = (slug: string) => slug.replace('-', ' ');
---

<BaseLayout title={listing.title} description={listing.description} whatsappTopic={listing.title.toLowerCase()}>
  {listing.canonical && <link rel="canonical" href={listing.canonical} slot="head" />}

  <section class="band">
    <div class="container band-inner">
      <Breadcrumbs items={listing.crumbs} />
      <h1>{listing.title}</h1>
      <p class="body-lg muted intro">{listing.intro}</p>

      <nav class="cat-tabs" aria-label="Product categories">
        {
          categoryTabs.map((tab) => (
            <a href={tab.href} class="cat-tab" aria-current={tab.kind === listing.kind ? 'page' : undefined}>
              {tab.label}
            </a>
          ))
        }
      </nav>

      {
        isTiles && !listing.fixed.space && (
          <nav class="sub-tabs" aria-label="Tile types">
            {tileTabs.map((tab) => (
              <a href={tab.href} class="sub-tab" aria-current={tab.id === listing.tileTab ? 'page' : undefined}>
                {tab.label}
              </a>
            ))}
          </nav>
        )
      }

      {
        showVitrifiedStrip && (
          <p class="vitrified">
            <strong>Vitrified tiles</strong>
            <span>Strong, low-water-absorption tiles that suit busy floors.</span>
            <a href="#guide" class="vitrified-link">
              Learn more
            </a>
          </p>
        )
      }
    </div>
  </section>

  <div
    class="container layout"
    data-listing
    data-groups={JSON.stringify(groupData)}
    data-noun={JSON.stringify(noun)}
    data-page-size={PAGE_SIZE}
    data-brand-routes={JSON.stringify(brandRoutes)}
  >
    <aside class="sidebar" aria-label="Filters">
      <FilterGroups groups={groups} scope="sidebar" />
    </aside>

    <div class="results">
      <div class="toolbar">
        <p class="count small" role="status" data-result-count>{items.length} {noun[items.length === 1 ? 0 : 1]}</p>
        <div class="active" data-active-chips></div>
        <button type="button" class="clear-all" data-clear-all hidden>Clear all</button>
        <div class="tools">
          <button type="button" class="filters-btn" data-open-filters>
            <span data-filters-label>Filters</span>
          </button>
          <label class="sort">
            <span class="visually-hidden">Sort by</span>
            <select data-sort>
              {SORTS.map((s) => <option value={s.key}>{s.label}</option>)}
            </select>
          </label>
        </div>
      </div>

      <h2 class="visually-hidden">{isTiles ? 'Collections' : 'Products'}</h2>
      <ul class:list={['grid', isTiles ? 'grid-tiles' : 'grid-products']} data-results>
        {
          items.map((item, i) => (
            <li
              data-listing-item
              data-id={item.id}
              data-name={item.name}
              data-order={item.order}
              data-new={item.isNew ? '' : undefined}
              data-trending={item.isTrending ? '' : undefined}
              data-facets={JSON.stringify(item.facets)}
              hidden={i >= PAGE_SIZE}
            >
              {item.type === 'tile' ? (
                <CollectionCard
                  id={item.tile.entry.id}
                  href={item.tile.href}
                  brand={item.tile.brand.name}
                  name={item.name}
                  colours={item.tile.colours}
                  finishes={item.tile.finishes}
                  sizes={item.tile.sizes}
                  dots={item.tile.dots}
                  tileFace={item.tile.dots[0]}
                  badge={item.isNew ? 'New' : undefined}
                  roomLabel={`${roomName(item.tile.entry.data.spaces[0])} with ${item.name} tiles`}
                  eager={i < 3}
                />
              ) : (
                <ProductCard
                  id={item.product.entry.id}
                  href={item.product.href}
                  brand={item.product.brand.name}
                  name={item.name}
                  code={item.product.entry.data.code}
                  spec={item.product.entry.data.keySpec}
                  authorised={item.product.brand.authorised}
                  swatch={item.product.entry.data.hex}
                />
              )}
            </li>
          ))
        }
        {
          features.visualizer && (
            <li class="help" data-help hidden>
              <a href={routes.visualizer} class="help-card">
                <span class="help-text">Not sure where to start? Try tiles in your room</span>
                <Icon name="arrow-right" size={22} class="arrow" />
              </a>
            </li>
          )
        }
        <li class="help" data-help hidden>
          <a href={whatsappUrl(listing.title.toLowerCase())} class="help-card" target="_blank" rel="noopener">
            <span class="help-text">Talk to us on WhatsApp</span>
            <Icon name="arrow-right" size={22} class="arrow" />
          </a>
        </li>
      </ul>

      <div class="empty" data-empty hidden>
        <h2 class="empty-title">No {noun[1]} match all these filters.</h2>
        <ul class="suggestions" data-suggestions></ul>
        <Button variant="secondary" data-clear-all>Clear filters</Button>
      </div>

      <div class="pager" data-pager>
        <p class="small muted tabular" data-showing></p>
        <Button variant="secondary" data-load-more>Load more</Button>
      </div>
    </div>
  </div>

  <section class="section guide" id="guide" aria-labelledby="guide-title">
    <div class="container">
      <div class="guide-inner" data-guide>
        <h2 id="guide-title" class="guide-title">{listing.guide.title}</h2>
        <div class="guide-body" id="guide-body" data-guide-body>
          {listing.guide.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <button type="button" class="read-more" aria-expanded="false" aria-controls="guide-body" data-read-more>
          Read more
        </button>
      </div>
    </div>
  </section>

  <Drawer id="filters" title="Filters">
    <FilterGroups groups={groups} scope="sheet" />
    <Fragment slot="footer">
      <div class="sheet-actions">
        <Button variant="secondary" data-sheet-clear>Clear</Button>
        <Button data-sheet-apply>Show results</Button>
      </div>
    </Fragment>
  </Drawer>
</BaseLayout>

<style>
  /* Page header band (ivory, ~280px). */
  .band {
    padding-block: var(--space-4) var(--space-3);
    border-bottom: var(--border);
  }

  .band-inner {
    display: grid;
    gap: var(--space-2);
  }

  h1 {
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .intro {
    margin-top: -4px;
  }

  .cat-tabs {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-2);
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: var(--border);
  }

  .cat-tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    color: var(--muted);
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .cat-tab::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px;
    height: 2px;
    background: var(--gold);
    transform: scaleX(0);
    transition: transform var(--dur-ui) var(--ease);
  }

  .cat-tab:hover,
  .cat-tab[aria-current='page'] {
    color: var(--green);
  }

  .cat-tab[aria-current='page']::after {
    transform: scaleX(1);
  }

  .sub-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .sub-tab {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 18px;
    border-radius: var(--radius-chip);
    background: var(--beige);
    color: var(--green);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }

  .sub-tab[aria-current='page'] {
    background: var(--green);
    color: var(--on-green);
  }

  .vitrified {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    max-width: none;
    margin-top: var(--space-1);
    padding: 14px var(--space-3);
    border-radius: var(--radius-button);
    background: var(--beige);
    font-size: var(--fs-small);
  }

  .vitrified strong {
    color: var(--green);
  }

  .vitrified-link {
    margin-left: auto;
    font-weight: 600;
  }

  /* Filters + results. */
  .layout {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-3) var(--space-8);
  }

  .sidebar {
    display: none;
  }

  @media (min-width: 1200px) {
    .layout {
      grid-template-columns: 280px minmax(0, 1fr);
      gap: var(--space-6);
    }

    .sidebar {
      display: block;
      position: sticky;
      top: calc(var(--header-h-compact) + var(--space-2));
      align-self: start;
      max-height: calc(100vh - var(--header-h-compact) - var(--space-4));
      overflow-y: auto;
      padding-right: 8px;
      scrollbar-width: thin;
    }
  }

  .toolbar {
    position: sticky;
    top: var(--header-h-compact);
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px var(--space-2);
    margin-bottom: var(--space-3);
    padding-block: 12px;
    border-bottom: var(--border);
    background: var(--ivory);
  }

  .count {
    color: var(--green);
    font-weight: 600;
  }

  .active {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .active :global(.active-chip) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 10px 0 14px;
    border: 0;
    border-radius: var(--radius-chip);
    background: var(--green);
    color: var(--on-green);
    font-size: 14px;
    font-weight: 500;
    animation: chip-in 200ms var(--ease);
  }

  @keyframes chip-in {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
  }

  .clear-all {
    min-height: 36px;
    padding: 0 4px;
    border: 0;
    background: none;
    color: var(--green);
    font-size: 14px;
    font-weight: 600;
    text-decoration: underline;
  }

  .clear-all[hidden] {
    display: none;
  }

  .tools {
    display: flex;
    gap: 8px;
    margin-left: auto;
  }

  .filters-btn {
    min-height: var(--touch-min);
    padding: 0 18px;
    border: 1.5px solid var(--green);
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--green);
    font-weight: 600;
  }

  @media (min-width: 1200px) {
    .filters-btn {
      display: none;
    }
  }

  .sort select {
    min-height: var(--touch-min);
    padding: 0 36px 0 14px;
    border: var(--border);
    border-radius: var(--radius-button);
    background: var(--surface);
    color: var(--green);
    font-weight: 500;
  }

  /* Results grid. */
  .grid {
    display: grid;
    gap: var(--space-6) var(--gutter);
    padding: 0;
    list-style: none;
  }

  .grid-tiles {
    grid-template-columns: 1fr;
  }

  .grid-products {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 600px) {
    .grid-tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 768px) {
    .grid-products {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .grid-tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .grid-products {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .grid > [hidden] {
    display: none;
  }

  /* Help tiles: desktop only, every 9th position. */
  .help {
    display: none;
  }

  @media (min-width: 1200px) {
    .help:not([hidden]) {
      display: block;
    }
  }

  .help-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-3);
    height: 100%;
    min-height: 280px;
    padding: var(--space-4);
    border-radius: var(--radius-image);
    background: var(--green);
    color: var(--on-green);
    text-decoration: none;
  }

  .help-text {
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.3;
  }

  .help-card :global(.arrow) {
    color: var(--gold);
    transition: transform var(--dur-ui) var(--ease);
  }

  .help-card:hover :global(.arrow) {
    transform: translateX(4px);
  }

  .help-card:focus-visible {
    outline-color: var(--gold);
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
    padding: var(--space-6) 0;
  }

  .empty[hidden] {
    display: none;
  }

  .empty-title {
    font-size: var(--fs-h3);
  }

  .suggestions {
    display: grid;
    gap: 4px;
    padding: 0;
    list-style: none;
  }

  .suggestions :global(button) {
    min-height: 40px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--green);
    font-weight: 500;
    text-align: left;
    text-decoration: underline;
  }

  .pager {
    display: grid;
    justify-items: center;
    gap: 12px;
    margin-top: var(--space-6);
  }

  .pager[hidden] {
    display: none;
  }

  /* The button's own display: inline-flex would otherwise beat the hidden attribute. */
  .pager :global([data-load-more][hidden]) {
    display: none;
  }

  /* Guide text, collapsed to three lines. */
  .guide {
    border-top: var(--border);
  }

  .guide-inner {
    display: grid;
    gap: var(--space-2);
    max-width: 68ch;
  }

  .guide-title {
    font-size: var(--fs-h3);
  }

  .guide-body {
    display: grid;
    gap: var(--space-2);
  }

  [data-guide]:not([data-expanded]) .guide-body {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  [data-guide]:not([data-expanded]) .guide-body p + p {
    display: none;
  }

  .read-more {
    justify-self: start;
    min-height: var(--touch-min);
    padding: 0;
    border: 0;
    background: none;
    color: var(--green);
    font-weight: 600;
    text-decoration: underline;
  }

  .sheet-actions {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 12px;
  }
</style>

<script>
  import {
    countSelected,
    filterItems,
    parseSelection,
    parseSort,
    sortItems,
    suggestRemovals,
    toQuery,
    type FilterItem,
    type Selection,
    type SortKey,
  } from '@/lib/filters';
  import { closeDrawer, openDrawer } from '@/scripts/drawer';

  interface GroupData {
    key: string;
    label: string;
    options: { value: string; label: string }[];
  }
  type Item = FilterItem & { el: HTMLElement };

  const root = document.querySelector<HTMLElement>('[data-listing]');
  if (root) initListing(root);

  function initListing(root: HTMLElement) {
    const groups: GroupData[] = JSON.parse(root.dataset.groups ?? '[]');
    const [one, many]: [string, string] = JSON.parse(root.dataset.noun ?? '["item","items"]');
    const pageSize = Number(root.dataset.pageSize ?? 12);
    const brandRoutes: Record<string, string> = JSON.parse(root.dataset.brandRoutes ?? '{}');

    // /products?brand=johnson → the listing where that brand has products.
    const params = new URLSearchParams(location.search);
    const brand = params.get('brand');
    if (brand && brandRoutes[brand]) {
      location.replace(brandRoutes[brand] + location.search);
      return;
    }

    const allowed = Object.fromEntries(groups.map((g) => [g.key, g.options.map((o) => o.value)]));
    const labelOf = (key: string, value: string) => groups.find((g) => g.key === key)?.options.find((o) => o.value === value)?.label ?? value;

    const grid = root.querySelector<HTMLElement>('[data-results]')!;
    const helps = [...grid.querySelectorAll<HTMLElement>('[data-help]')];
    const items: Item[] = [...grid.querySelectorAll<HTMLElement>('[data-listing-item]')].map((el) => ({
      el,
      id: el.dataset.id ?? '',
      name: el.dataset.name ?? '',
      order: Number(el.dataset.order ?? 0),
      isNew: el.hasAttribute('data-new'),
      isTrending: el.hasAttribute('data-trending'),
      facets: JSON.parse(el.dataset.facets ?? '{}'),
    }));

    const sidebar = root.querySelector<HTMLElement>('[data-filter-scope="sidebar"]');
    const sheet = document.querySelector<HTMLElement>('[data-filter-scope="sheet"]');
    const sortSelect = root.querySelector<HTMLSelectElement>('[data-sort]');
    const count = root.querySelector<HTMLElement>('[data-result-count]');
    const chips = root.querySelector<HTMLElement>('[data-active-chips]');
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const suggestionList = root.querySelector<HTMLElement>('[data-suggestions]');
    const pager = root.querySelector<HTMLElement>('[data-pager]');
    const showing = root.querySelector<HTMLElement>('[data-showing]');
    const loadMore = root.querySelector<HTMLButtonElement>('[data-load-more]');
    const filtersLabel = root.querySelector<HTMLElement>('[data-filters-label]');
    const applyButton = document.querySelector<HTMLButtonElement>('[data-sheet-apply]');

    const state = {
      selection: parseSelection(params, allowed),
      sort: parseSort(params.get('sort')) as SortKey,
      shown: pageSize,
    };
    if (sortSelect) sortSelect.value = state.sort;

    const plural = (n: number) => `${n} ${n === 1 ? one : many}`;

    function readScope(scope: HTMLElement | null): Selection {
      const selection: Selection = Object.fromEntries(groups.map((g) => [g.key, []]));
      scope?.querySelectorAll<HTMLInputElement>('[data-filter-input]:checked').forEach((input) => {
        selection[input.name]?.push(input.value);
      });
      return selection;
    }

    function writeScope(scope: HTMLElement | null, selection: Selection) {
      scope?.querySelectorAll<HTMLInputElement>('[data-filter-input]').forEach((input) => {
        input.checked = !!selection[input.name]?.includes(input.value);
      });
      scope?.querySelectorAll<HTMLElement>('[data-filter-group]').forEach((group) => {
        const n = selection[group.dataset.filterGroup ?? '']?.length ?? 0;
        const badge = group.querySelector<HTMLElement>('[data-group-count]');
        if (badge) {
          badge.hidden = n === 0;
          badge.textContent = String(n);
        }
      });
    }

    function removeValue(key: string, value: string) {
      state.selection = { ...state.selection, [key]: state.selection[key].filter((v) => v !== value) };
      state.shown = pageSize;
      render();
    }

    function clearAll() {
      state.selection = Object.fromEntries(groups.map((g) => [g.key, []]));
      state.shown = pageSize;
      render();
    }

    function render({ fade = true, revealFrom = -1 } = {}) {
      const matched = sortItems(filterItems(items, state.selection), state.sort);
      const matchedIds = new Set(matched.map((m) => m.id));

      // Reorder: matching items in sort order first, then the rest (hidden).
      matched.forEach((item, i) => {
        item.el.hidden = i >= state.shown;
        grid.append(item.el);
      });
      items.filter((i) => !matchedIds.has(i.id)).forEach((item) => {
        item.el.hidden = true;
        grid.append(item.el);
      });

      // Help tiles at every 9th position (max 2), among what is shown.
      const visible = matched.slice(0, state.shown);
      helps.forEach((help, n) => {
        const anchor = visible[8 * (n + 1)];
        help.hidden = !anchor;
        if (anchor) grid.insertBefore(help, anchor.el);
      });

      if (count) count.textContent = plural(matched.length);
      if (empty) empty.hidden = matched.length > 0;
      if (pager) pager.hidden = matched.length === 0;
      if (showing) showing.textContent = `Showing ${Math.min(state.shown, matched.length)} of ${matched.length}`;
      if (loadMore) loadMore.hidden = state.shown >= matched.length;

      // Active filter chips.
      if (chips) {
        chips.replaceChildren(
          ...groups.flatMap((g) =>
            state.selection[g.key].map((value) => {
              const chip = document.createElement('button');
              chip.type = 'button';
              chip.className = 'active-chip';
              chip.innerHTML = `<span></span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>`;
              chip.querySelector('span')!.textContent = labelOf(g.key, value);
              chip.setAttribute('aria-label', `Remove filter: ${labelOf(g.key, value)}`);
              chip.addEventListener('click', () => removeValue(g.key, value));
              return chip;
            }),
          ),
        );
      }
      const selected = countSelected(state.selection);
      root.querySelectorAll<HTMLElement>('[data-clear-all]').forEach((b) => {
        if (b.closest('[data-empty]')) return;
        b.hidden = selected === 0;
      });
      if (filtersLabel) filtersLabel.textContent = selected ? `Filters (${selected})` : 'Filters';

      // Empty state: the nearest suggestions.
      if (suggestionList) {
        const suggestions = matched.length ? [] : suggestRemovals(items, state.selection);
        suggestionList.replaceChildren(
          ...suggestions.map((s) => {
            const li = document.createElement('li');
            const b = document.createElement('button');
            b.type = 'button';
            b.textContent = `Try removing '${labelOf(s.key, s.value)}' (${plural(s.count)})`;
            b.addEventListener('click', () => removeValue(s.key, s.value));
            li.append(b);
            return li;
          }),
        );
      }

      writeScope(sidebar, state.selection);
      history.replaceState(null, '', location.pathname + toQuery(state.selection, state.sort) + location.hash);

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (fade && !reduce) grid.animate([{ opacity: 0.35 }, { opacity: 1 }], { duration: 200, easing: 'ease-out' });
      if (revealFrom >= 0 && !reduce) {
        visible.slice(revealFrom).forEach((item, i) => {
          item.el.animate([{ opacity: 0, transform: 'translateY(16px)' }, { opacity: 1, transform: 'none' }], {
            duration: 500,
            delay: i * 60,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
            fill: 'backwards',
          });
        });
      }
    }

    // Desktop sidebar: apply instantly.
    sidebar?.addEventListener('change', () => {
      state.selection = readScope(sidebar);
      state.shown = pageSize;
      render();
    });

    sortSelect?.addEventListener('change', () => {
      state.sort = parseSort(sortSelect.value);
      render();
    });

    loadMore?.addEventListener('click', () => {
      const from = state.shown;
      state.shown += pageSize;
      render({ fade: false, revealFrom: from });
    });

    root.querySelectorAll('[data-clear-all]').forEach((b) => b.addEventListener('click', clearAll));

    // Touch bottom sheet: choose, then apply with "Show N results".
    const updateApply = () => {
      const pending = readScope(sheet);
      writeScope(sheet, pending);
      if (applyButton) applyButton.textContent = `Show ${plural(filterItems(items, pending).length)}`;
    };
    root.querySelector('[data-open-filters]')?.addEventListener('click', (event) => {
      writeScope(sheet, state.selection);
      updateApply();
      openDrawer('filters', event.currentTarget as HTMLElement);
    });
    sheet?.addEventListener('change', updateApply);
    document.querySelector('[data-sheet-clear]')?.addEventListener('click', () => {
      writeScope(sheet, Object.fromEntries(groups.map((g) => [g.key, []])));
      updateApply();
    });
    applyButton?.addEventListener('click', () => {
      state.selection = readScope(sheet);
      state.shown = pageSize;
      closeDrawer();
      render();
    });

    // Guide: three lines, then "Read more".
    const guide = document.querySelector<HTMLElement>('[data-guide]');
    const readMore = guide?.querySelector<HTMLButtonElement>('[data-read-more]');
    readMore?.addEventListener('click', () => {
      const open = !guide!.hasAttribute('data-expanded');
      guide!.toggleAttribute('data-expanded', open);
      readMore.setAttribute('aria-expanded', String(open));
      readMore.textContent = open ? 'Read less' : 'Read more';
    });
    document.querySelector('a[href="#guide"]')?.addEventListener('click', () => {
      guide?.setAttribute('data-expanded', '');
      readMore?.setAttribute('aria-expanded', 'true');
      if (readMore) readMore.textContent = 'Read less';
    });

    render({ fade: false });
  }
</script>
