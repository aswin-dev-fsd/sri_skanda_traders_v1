---
// Collection 07 — Room gallery: large 16:9 slider with thumbnails, arrows, swipe and a "3 / 8"
// counter. Tap opens the lightbox. Each caption names the colour used.
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import PhotoPlaceholder from '@/components/ui/PhotoPlaceholder.astro';

interface Slide {
  image?: ImageMetadata;
  caption: string;
  /** Stand-in background while there is no photo. */
  face: string;
}

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
const lightboxSrc = await Promise.all(slides.map(async (s) => (s.image ? (await getImage({ src: s.image, width: 1600 })).src : undefined)));
---

<section class="section" aria-labelledby="rooms-title" data-room-gallery>
  <div class="container">
    <div class="head" data-reveal>
      <p class="eyebrow">In real rooms</p>
      <h2 id="rooms-title">See it laid.</h2>
    </div>

    <div class="viewer" data-reveal>
      <div class="track" data-room-track tabindex="0" aria-label="Room photos">
        {
          slides.map((s, i) => (
            <figure class="slide" data-room-slide>
              <button
                type="button"
                class="slide-btn"
                data-lightbox
                data-lightbox-group="rooms"
                data-lightbox-src={lightboxSrc[i]}
                data-lightbox-face={s.face}
                data-lightbox-caption={s.caption}
                aria-label={`${s.caption}, open larger`}
              >
                {s.image ? (
                  <Image src={s.image} alt={s.caption} widths={[640, 1024, 1440]} sizes="(min-width: 1320px) 1320px, 100vw" />
                ) : (
                  <PhotoPlaceholder label={s.caption.toLowerCase()} face={s.face} />
                )}
              </button>
              <figcaption class="small">{s.caption}</figcaption>
            </figure>
          ))
        }
      </div>
      <div class="controls">
        <p class="counter tabular" aria-live="polite"><span data-room-index>1</span> / {slides.length}</p>
        <div class="arrows">
          <button type="button" class="nav-btn" aria-label="Previous photo" data-room-prev>
            <Icon name="arrow-right" size={20} class="flip" />
          </button>
          <button type="button" class="nav-btn" aria-label="Next photo" data-room-next>
            <Icon name="arrow-right" size={20} />
          </button>
        </div>
      </div>
      <ul class="thumbs">
        {
          slides.map((s, i) => (
            <li>
              <button
                type="button"
                class="thumb"
                style={`background: ${s.face}`}
                aria-label={`Show photo ${i + 1}: ${s.caption}`}
                aria-current={i === 0 ? 'true' : undefined}
                data-room-thumb={i}
              >
                {s.image && <Image src={s.image} alt="" width={160} height={90} />}
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    border-radius: var(--radius-image);
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: start;
  }

  .slide-btn {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    padding: 0;
    border: 0;
    border-radius: var(--radius-image);
    cursor: zoom-in;
  }

  .slide-btn :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    margin-top: 10px;
    color: var(--muted);
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-2);
  }

  .counter {
    color: var(--green);
    font-weight: 600;
  }

  .arrows {
    display: flex;
    gap: 12px;
  }

  .nav-btn {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1.5px solid var(--green);
    border-radius: 50%;
    background: transparent;
    color: var(--green);
  }

  .nav-btn:hover {
    background: rgba(18, 59, 50, 0.06);
  }

  .nav-btn :global(.flip) {
    transform: rotate(180deg);
  }

  .thumbs {
    display: flex;
    gap: 10px;
    margin-top: var(--space-2);
    padding: 0;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }

  .thumb {
    width: 96px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 10px;
    opacity: 0.6;
    transition:
      opacity var(--dur-ui) var(--ease),
      border-color var(--dur-ui) var(--ease);
  }

  .thumb[aria-current='true'] {
    border-color: var(--gold);
    opacity: 1;
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-room-gallery]').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('[data-room-track]')!;
    const slides = [...gallery.querySelectorAll<HTMLElement>('[data-room-slide]')];
    const thumbs = [...gallery.querySelectorAll<HTMLElement>('[data-room-thumb]')];
    const indexEl = gallery.querySelector('[data-room-index]');
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => track.scrollTo({ left: ((i + slides.length) % slides.length) * track.clientWidth, behavior: 'smooth' });

    track.addEventListener(
      'scroll',
      () => {
        const i = current();
        if (indexEl) indexEl.textContent = String(i + 1);
        thumbs.forEach((t, n) => (n === i ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
      },
      { passive: true },
    );
    gallery.querySelector('[data-room-prev]')?.addEventListener('click', () => go(current() - 1));
    gallery.querySelector('[data-room-next]')?.addEventListener('click', () => go(current() + 1));
    thumbs.forEach((t, n) => t.addEventListener('click', () => go(n)));
    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') go(current() + 1);
      if (event.key === 'ArrowLeft') go(current() - 1);
    });
  });
</script>
