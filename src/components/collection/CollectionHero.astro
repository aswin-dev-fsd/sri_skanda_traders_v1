---
// Collection 01 — Hero: full-width room photo (70vh, min 520px) with the tile reveal; breadcrumb,
// brand, name, description, quick facts and actions over a soft green gradient.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import PhotoPlaceholder from '@/components/ui/PhotoPlaceholder.astro';
import SaveStar from '@/components/ui/SaveStar.astro';
import TileReveal from '@/components/ui/TileReveal.astro';
import { features, routes } from '@/config/site';
import type { SelectionItem } from '@/lib/types';

interface Props {
  name: string;
  brand: string;
  description: string;
  image?: ImageMetadata;
  /** Placeholder background until the photo arrives. */
  face: string;
  roomLabel: string;
  facts: string[];
  item: SelectionItem;
}

const { name, brand, description, image, face, roomLabel, facts, item } = Astro.props;
---

<section class="hero" data-collection-hero aria-labelledby="collection-title">
  <TileReveal class="photo" cover="var(--green)">
    {
      image ? (
        <Image src={image} alt={roomLabel} widths={[768, 1280, 1920, 2560]} sizes="100vw" loading="eager" fetchpriority="high" />
      ) : (
        <PhotoPlaceholder label={roomLabel} face={face} />
      )
    }
  </TileReveal>
  <div class="shade" aria-hidden="true"></div>

  <div class="content container on-green-text">
    <Breadcrumbs items={[{ label: 'Home', href: routes.home }, { label: 'Tiles', href: routes.tiles }, { label: name }]} light />
    <p class="eyebrow brand">{brand}</p>
    <h1 id="collection-title">{name}</h1>
    <p class="body-lg desc">{description}</p>
    <ul class="facts">
      {facts.map((f) => <li class="tabular">{f}</li>)}
    </ul>
    <div class="buttons">
      {
        features.visualizer && (
          <Button variant="accent" href={routes.visualizer} icon="cube">
            Try in 3D
          </Button>
        )
      }
      <SaveStar item={item} class="hero-star" />
      <Button variant="outline-light" href={routes.contact} data-enquire data-item={JSON.stringify(item)}>Enquire</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: max(520px, 70vh);
    overflow: hidden;
    background: var(--green);
  }

  .hero :global(.photo) {
    position: absolute;
    inset: 0;
  }

  .hero :global(.photo img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Soft green gradient for legible text (#123B32 0 → 60%). */
  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(18, 59, 50, 0) 10%, rgba(18, 59, 50, 0.6) 45%, rgba(18, 59, 50, 0.6) 100%);
    pointer-events: none;
  }

  .content {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-12) var(--space-6);
    color: var(--on-green);
  }

  .brand {
    color: var(--gold);
  }

  h1 {
    color: var(--on-green);
  }

  .desc {
    max-width: 52ch;
    color: var(--on-green);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    list-style: none;
  }

  .facts li {
    padding: 6px 14px;
    border-radius: var(--radius-chip);
    background: rgba(18, 59, 50, 0.6);
    color: var(--on-green);
    font-size: var(--fs-small);
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: var(--space-1);
  }

  .buttons :global(.hero-star) {
    width: 52px;
    height: 52px;
  }

  .content :global(:focus-visible) {
    outline-color: var(--gold);
  }
</style>
