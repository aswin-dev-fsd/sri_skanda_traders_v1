---
// Visible stand-in for a photo the client has not supplied yet, labelled "[PHOTO: …]" as the brief asks.
interface Props {
  /** What the photo should show, e.g. "living room with a light floor". */
  label: string;
  /** Any CSS background, e.g. a flat tile colour. Defaults to Stone Beige. */
  face?: string;
  class?: string;
}

const { label, face, class: className } = Astro.props;
---

<span class:list={['placeholder', className]} style={face ? `background: ${face}` : undefined} role="img" aria-label={label}>
  <span class="placeholder-label">[PHOTO: {label}]</span>
</span>

<style>
  .placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: var(--space-2);
    background: var(--beige);
  }

  .placeholder-label {
    max-width: 24ch;
    padding: 4px 10px;
    border-radius: 6px;
    background: rgba(255, 253, 248, 0.85);
    color: var(--muted);
    font-size: 12px;
    line-height: 1.4;
    text-align: center;
  }
</style>
