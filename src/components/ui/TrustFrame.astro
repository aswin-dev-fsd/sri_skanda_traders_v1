---
// The Trust Frame (brief signature touch 1): a 1.5px gold rounded frame, offset from its content,
// open at the bottom where a small label sits in the gap. On first view the line draws itself
// (900ms) from top-centre down both sides, arriving at the label, which fades in as the lines
// meet it (see DECISIONS.md). The draw is chained after the rise/reveal of the content around it,
// so the content settles first and the line follows. Use at most 1–2 per screen.
//
// Without JavaScript it falls back to a plain CSS border behind the label.

interface Props {
  /** Text in the bottom gap, e.g. "Our showroom · Sulur, Coimbatore". */
  label: string;
  /** Background the frame sits on, so the label can mask the line. */
  tone?: 'ivory' | 'green' | 'beige' | 'surface';
  class?: string;
}

const { label, tone = 'ivory', class: className } = Astro.props;
---

<div class:list={['trust-frame', `tone-${tone}`, className]} data-trust-frame>
  <svg class="frame-svg" aria-hidden="true" focusable="false">
    <path class="frame-line" data-side="left"></path>
    <path class="frame-line" data-side="right"></path>
  </svg>
  <div class="frame-content">
    <slot />
  </div>
  <p class="frame-label">{label}</p>
</div>

<style>
  .trust-frame {
    --offset: 16px;
    --frame-radius: calc(var(--radius-image) + var(--offset));
    position: relative;
    padding: var(--offset);
  }

  @media (max-width: 767px) {
    .trust-frame {
      --offset: 12px;
    }

    .trust-frame .frame-label {
      padding: 0 10px;
      font-size: 11px;
      letter-spacing: 0.08em;
    }
  }

  /* No-JS fallback: plain border; the label background masks the gap. */
  .trust-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 1.5px solid var(--gold);
    border-radius: var(--frame-radius);
    pointer-events: none;
  }

  .trust-frame[data-ready]::before {
    display: none;
  }

  .frame-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .frame-line {
    fill: none;
    stroke: var(--gold);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .frame-content {
    position: relative;
  }

  .frame-label {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: 2;
    max-width: calc(100% - 2 * var(--frame-radius));
    padding: 0 16px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transform: translate(-50%, 50%);
  }

  .tone-ivory .frame-label {
    background: var(--ivory);
    color: var(--green);
  }

  .tone-surface .frame-label {
    background: var(--surface);
    color: var(--green);
  }

  .tone-beige .frame-label {
    background: var(--beige);
    color: var(--green);
  }

  .tone-green .frame-label {
    background: var(--green);
    color: var(--gold);
  }

  /* Once JS has measured the label, it leaves the gap open, so no mask is needed.
     The label waits hidden until the lines arrive at it (JS fades it in). */
  .trust-frame[data-ready] .frame-label {
    background: transparent;
    opacity: 0;
  }

  .trust-frame[data-drawn] .frame-label {
    opacity: 1;
  }
</style>

<script>
  const DRAW_MS = 900;
  const GAP_PAD = 8;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  /** Path for one half of the frame: from the gap edge, round the bottom corner, up the side, across to top-centre. */
  function halfPath(w: number, h: number, r: number, gapHalf: number, side: 'left' | 'right'): string {
    const c = w / 2;
    const i = 0.75; // half the stroke width, keeps the line inside the box
    if (side === 'left') {
      return `M ${c - gapHalf} ${h - i} H ${r} A ${r - i} ${r - i} 0 0 1 ${i} ${h - r} V ${r} A ${r - i} ${r - i} 0 0 1 ${r} ${i} H ${c}`;
    }
    return `M ${c + gapHalf} ${h - i} H ${w - r} A ${r - i} ${r - i} 0 0 0 ${w - i} ${h - r} V ${r} A ${r - i} ${r - i} 0 0 0 ${w - r} ${i} H ${c}`;
  }

  function layout(frame: HTMLElement) {
    const { width: w, height: h } = frame.getBoundingClientRect();
    const label = frame.querySelector<HTMLElement>('.frame-label');
    const r = parseFloat(getComputedStyle(frame).getPropertyValue('--frame-radius')) || 32;
    const gapHalf = Math.min((label?.offsetWidth ?? 0) / 2 + GAP_PAD, w / 2 - r);
    frame.querySelectorAll<SVGPathElement>('.frame-line').forEach((path) => {
      path.setAttribute('d', halfPath(w, h, r, gapHalf, path.dataset.side as 'left' | 'right'));
      // After the draw, a resize changes the path length: drop the dash so the line stays whole.
      if (frame.hasAttribute('data-drawn')) path.style.strokeDasharray = 'none';
    });
  }

  const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';
  const LABEL_MS = 300;
  // Chain after the surrounding content's entrance: start once it is ~60% through.
  const RISE_MS = 800; // global `.rise` (page load), staggered 80ms by --i
  const RISE_STEP = 80;
  const REVEAL_MS = 600; // global `[data-reveal]` (scroll), staggered 60ms by --i
  const REVEAL_STEP = 60;
  const LEAD_IN = 0.6;

  // Paths run from the gap up to top-centre; a negative dash offset reveals them from their END,
  // so the line draws from top-centre down both sides and arrives at the label.
  function hideLines(frame: HTMLElement) {
    frame.querySelectorAll<SVGPathElement>('.frame-line').forEach((path) => {
      const length = path.getTotalLength();
      path.style.strokeDasharray = `${length}`;
      path.style.strokeDashoffset = `${-length}`;
    });
  }

  function draw(frame: HTMLElement, delay = 0) {
    if (frame.hasAttribute('data-drawing')) return;
    frame.setAttribute('data-drawing', '');
    const still = reduceMotion.matches;
    frame.querySelectorAll<SVGPathElement>('.frame-line').forEach((path) => {
      const length = path.getTotalLength();
      path.style.strokeDasharray = `${length}`;
      path.animate([{ strokeDashoffset: -length }, { strokeDashoffset: 0 }], {
        duration: still ? 0 : DRAW_MS,
        delay: still ? 0 : delay,
        easing: EASE,
        fill: 'both',
      });
    });
    // The label fades in as the two lines reach it.
    const label = frame.querySelector<HTMLElement>('.frame-label');
    label
      ?.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: still ? 0 : LABEL_MS,
        delay: still ? 0 : delay + DRAW_MS - LABEL_MS,
        easing: EASE,
        fill: 'both',
      })
      .finished.then(() => frame.setAttribute('data-drawn', ''))
      .catch(() => frame.setAttribute('data-drawn', ''));
  }

  const stagger = (el: Element) => parseFloat(getComputedStyle(el).getPropertyValue('--i')) || 0;

  /** Draws once the frame is in view; `delayFor` is read at that moment. */
  function whenVisible(frame: HTMLElement, delayFor: () => number) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        draw(frame, delayFor());
      },
      { threshold: 0.3 },
    );
    io.observe(frame);
  }

  const frames = [...document.querySelectorAll<HTMLElement>('[data-trust-frame]')];
  const resizer = new ResizeObserver((entries) => entries.forEach((e) => layout(e.target as HTMLElement)));

  frames.forEach((frame) => {
    layout(frame);
    hideLines(frame); // nothing flashes before the draw
    frame.setAttribute('data-ready', '');
    resizer.observe(frame);

    const revealHost = frame.closest<HTMLElement>('[data-reveal]');
    const riseHost = frame.closest<HTMLElement>('.rise');

    if (revealHost) {
      // Scroll reveal: start when the host is revealed, ~60% into its fade-up.
      const go = () => draw(frame, REVEAL_MS * LEAD_IN + stagger(revealHost) * REVEAL_STEP);
      if (revealHost.hasAttribute('data-revealed')) go();
      else {
        const mo = new MutationObserver(() => {
          if (!revealHost.hasAttribute('data-revealed')) return;
          mo.disconnect();
          go();
        });
        mo.observe(revealHost, { attributes: true, attributeFilter: ['data-revealed'] });
      }
    } else if (riseHost) {
      // Page-load rise: wait out whatever is left of its first ~60% (0 if already past).
      const riseAt = RISE_MS * LEAD_IN + stagger(riseHost) * RISE_STEP;
      whenVisible(frame, () => Math.max(0, riseAt - performance.now()));
    } else {
      // No entrance around it (e.g. inside a dialog): draw on first view.
      whenVisible(frame, () => 0);
    }
  });
</script>
